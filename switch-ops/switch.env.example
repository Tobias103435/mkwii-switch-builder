# Switch-filetransfer: vul dit in en hernoem naar switch.env
# IP van je Switch (staat op het FTPD-scherm en in hbmenu onder "IP:")
SWITCH_IP=192.168.1.x
SWITCH_FTP_PORT=5000
SWITCH_FTP_USER=
SWITCH_FTP_PASS=

# Al deze paden mag ik schrijven/lezen; niets daarbuiten.
DEPLOY_DIR=/switch/WiiCompiled-Switch
LOG_DIR=/switch/WiiCompiled-Switch/Logs
