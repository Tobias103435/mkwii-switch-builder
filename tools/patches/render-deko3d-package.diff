 fi
 
+if [[ "$RENDER_PACKAGE" == 0 ]]; then
 uam_diff_sha256="$(git -C "$UAM_ROOT" diff HEAD --binary | sha256sum | awk '{print $1}')"
 dawn_diff_sha256="$(git -C "$DAWN_SOURCE_DIR" diff HEAD --binary -- . ':(exclude)third_party/abseil-cpp' | sha256sum | awk '{print $1}')"
 dawn_abseil_diff_sha256="$(git -C "$DAWN_ABSEIL_DIR" diff HEAD --binary | sha256sum | awk '{print $1}')"
@@ -230,6 +258,81 @@ try:
 except (OSError, ValueError) as error:
     raise SystemExit(f"error: dependency provenance invalid; rebuild dependencies: {error}")
 PY
+else
+    python3 - "$DEP_RECEIPT" "$DAWN_ARCHIVE" "$UAM_LIB" "$DAWN_PATCH" "$AURORA_ABSEIL_PATCH" \
+        "$DAWN_SWITCH_PATCHER" "$DAWN_ABSEIL_PATCHER" \
+        "driftdroid_reference=$REF_PIN" \
+        "dawn_base_commit=$DAWN_BASE_PIN" \
+        "dawn_abseil_commit=$DAWN_ABSEIL_PIN" \
+        "uam_commit=$UAM_PIN" \
+        "dawn_tint_build_wgsl_reader=ON" \
+        "dawn_tint_build_wgsl_writer=ON" \
+        "dawn_tint_build_glsl_writer=ON" \
+        "dawn_tint_build_glsl_validator=OFF" \
+        "dawn_tint_build_spv_reader=OFF" \
+        "dawn_tint_build_spv_writer=OFF" \
+        "dawn_tint_build_hlsl_writer=OFF" \
+        "dawn_tint_build_msl_writer=OFF" \
+        "dawn_tint_build_null_writer=OFF" <<'PY'
+from pathlib import Path
+import hashlib
+import sys
+
+# argv: receipt, Dawn archive, libuam, Dawn patch, Aurora Abseil patch,
+# Dawn Switch patcher, Abseil Switch patcher, then key=value expectations.
+HASHED = {
+    "dawn_archive_sha256": 2,
+    "uam_archive_sha256": 3,
+    "dawn_patch_sha256": 4,
+    "aurora_abseil_patch_sha256": 5,
+    "dawn_switch_patcher_sha256": 6,
+    "dawn_abseil_patcher_sha256": 7,
+}
+
+def digest(path):
+    state = hashlib.sha256()
+    with open(path, "rb") as handle:
+        for block in iter(lambda: handle.read(1 << 20), b""):
+            state.update(block)
+    return state.hexdigest()
+
+try:
+    entries = {}
+    for line in Path(sys.argv[1]).read_text().splitlines():
+        key, value = line.split("=", 1)
+        if key in entries:
+            raise ValueError(f"duplicate field: {key}")
+        entries[key] = value
+    for field in sys.argv[8:]:
+        key, expected = field.split("=", 1)
+        if entries.get(key) != expected:
+            raise ValueError(f"{key} differs from the pinned value")
+    for key, index in HASHED.items():
+        if entries.get(key) != digest(sys.argv[index]):
+            raise ValueError(f"{key} differs from the bytes this package ships")
+except (OSError, ValueError) as error:
+    raise SystemExit(f"error: render-stack package provenance invalid: {error}")
+
+# The worktree-diff, cache and tool-version fields describe the machine that
+# packed this archive. They are reported, not reproduced: the hashes above tie
+# these bytes to the same pins and the same Switch patches.
+recorded = [key for key in ("dawn_worktree_diff_sha256", "dawn_abseil_diff_sha256",
+                            "dawn_cmake_cache_sha256", "uam_worktree_diff_sha256",
+                            "compiler", "cmake", "ninja", "meson", "devkitpro")
+            if key in entries]
+print("==> Render-stack package verified: shipped bytes match this repository's pins and patches")
+print(f"    recorded on the packing host: {', '.join(recorded)}")
+PY
+    actual_dawn_head="$DAWN_BASE_PIN"
+    actual_dawn_abseil_head="$DAWN_ABSEIL_PIN"
+    uam_head="$UAM_PIN"
+    # These three describe the worktrees of the machine that built this package;
+    # they are carried over from its receipt, because this machine has no source
+    # trees to re-derive them from. The byte-level provenance above is re-computed.
+    dawn_diff_sha256="$(awk -F= '$1=="dawn_worktree_diff_sha256"{print $2}' "$DEP_RECEIPT")"
+    dawn_abseil_diff_sha256="$(awk -F= '$1=="dawn_abseil_diff_sha256"{print $2}' "$DEP_RECEIPT")"
+    uam_diff_sha256="$(awk -F= '$1=="uam_worktree_diff_sha256"{print $2}' "$DEP_RECEIPT")"
+fi
 
 mkdir -p "$BUILD_DIR" "$OUTPUT_DIR"
 
@@ -251,6 +354,7 @@ configure=(
 cat <<EOF_CONFIG
 ==> Configuring optimized Switch product
     backend       : Dawn/WebGPU -> native Deko3D
+    render stack  : $([[ "$RENDER_PACKAGE" == 1 ]] && echo "prebuilt package ($DAWN_BUILD_DIR)" || echo "built from the audited source tree")
     Dawn base     : $actual_dawn_head
     Dawn Abseil   : $actual_dawn_abseil_head + audited libnx delta
     UAM pin       : $uam_head
@@ -331,6 +435,7 @@ fi
 
