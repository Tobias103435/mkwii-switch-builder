+
+# A render-stack package (tools/render-deps.sh) carries the compiled archives and
+# the headers the link needs, not the 3.4 GiB Dawn checkout that the worktree
+# audits below inspect. Provenance then comes from the package's own receipt
+# instead: its archive, patch and patcher hashes are recomputed here against this
+# repository's pinned files, so the same guarantee holds on bytes rather than on
+# a git worktree. Editing any Switch patch invalidates the package exactly as it
+# invalidates a locally built tree.
+if [[ -f "$DEPS_DIR/.mkw-render-package" ]]; then
+    RENDER_PACKAGE=1
+else
