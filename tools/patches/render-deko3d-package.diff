@@ -96,6 +96,26 @@ if [[ "$(git -C "$REF_DIR" rev-parse HEAD)" != "$REF_PIN" ]]; then
     echo "error: DriftDroid reference pin mismatch" >&2
     exit 3
 fi
+if [[ ! -f "$DAWN_PATCH" || ! -f "$AURORA_ABSEIL_PATCH" || ! -f "$DAWN_ABSEIL_PATCHER" || ! -f "$DAWN_SWITCH_PATCHER" ]]; then
